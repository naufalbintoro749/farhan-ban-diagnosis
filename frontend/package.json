{
  "name": "sistem-pakar-mil-motor-frontend",
  "version": "1.0.0",
  "description": "Frontend React untuk Sistem Pakar Diagnosis Kerusakan Sepeda Motor (MIL) - Farhan Motor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
