    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/pdfkit": "^0.13.3",
    "fast-check": "^3.14.0",
    "prisma": "^5.7.1",
